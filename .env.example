PORT=3000
MONGODB_URI=mongodb://localhost:27017/job-board
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
OPENROUTER_API_KEY=
# Free model first; the paid fallback is used only if the free one fails (empty = no paid fallback).
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash-lite
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Shared key for the mobile app's no-login "submitter" (submission only). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SUBMIT_API_KEY=
